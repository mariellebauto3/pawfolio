APP_NAME=Pawfolio
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# The Next.js frontend; emailed links (password reset) open pages there.
FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=aws-0-ap-southeast-2.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=
DB_PASSWORD=
DB_SSLMODE=require
# Set true only when using Supabase transaction pooling (port 6543).
DB_EMULATE_PREPARES=false
DB_DISABLE_PREPARES=true

# Local single-server storage avoids cloud database round trips.
# Production with multiple instances must use a shared session/cache store.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000

PAWFOLIO_ADMIN_EMAIL=admin@pawfolio.ph
PAWFOLIO_ADMIN_NAME=admin.pawfolio
PAWFOLIO_ADMIN_PASSWORD=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# local for development; supabase for durable deployed uploads on both named disks.
UPLOAD_STORAGE=local
SUPABASE_URL=
SUPABASE_PUBLIC_BUCKET=pawfolio-public
SUPABASE_PRIVATE_BUCKET=pawfolio-private
# Copy these from Supabase Storage's S3 configuration, not the project API keys.
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
QUEUE_CONNECTION=database
# Runs the scheduled jobs (routes/console.php) after API answers, at most once every 5 minutes; Render's free plan
# has no cron or worker (ADR 0008). Turn off only where `php artisan schedule:run` runs instead.
RUN_DUE_JOBS_ON_REQUESTS=true

CACHE_STORE=file
# Optional public read cache. Leave unset until a shared Redis service is verified.
# READ_CACHE_STORE=redis
# Production rate counters and login lockouts should remain shared and fail closed.
# RATE_LIMIT_STORE=database
# AUTH_LOCKOUT_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
# Production: rediss://username:password@host:port (TLS with certificate verification).
# REDIS_URL=
# REDIS_CACHE_DB=0
# REDIS_CACHE_CONNECT_TIMEOUT=0.25
# REDIS_CACHE_READ_TIMEOUT=0.25
# REDIS_CACHE_MAX_RETRIES=0
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Local development: "log" writes every email, reset links included, to storage/logs/laravel.log.
# Render: "brevo" sends through Brevo's HTTPS API; the free plan blocks the SMTP ports (ADR 0007).
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# With "brevo": a sender verified in Brevo (Senders, Domains & Dedicated IPs).
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
# Brevo → SMTP & API → API keys. Only in .env and Render's environment, never committed (SEC-SECRET-01).
BREVO_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Aggregate dashboard metrics only; auth/session/lockout stores remain separately configured.
# Use a shared Redis store when running multiple application instances.
READ_CACHE_STORE=file
