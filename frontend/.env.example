# Copy to .env.local and adjust. NEXT_PUBLIC_* values are bundled into the browser: never put secrets here (SEC-FE-03).

# Laravel API origin (no trailing slash). Server calls and /backend rewrites use this destination.
# Browser calls use the frontend's /backend path so cookies are available to server page guards.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional public photo bucket base URL; required on Vercel when using Supabase uploads.
# https://<project-ref>.supabase.co/storage/v1/object/public/pawfolio-public
NEXT_PUBLIC_STORAGE_URL=

# This frontend's origin. Must be listed in the backend's SANCTUM_STATEFUL_DOMAINS and CORS allowed origins.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# live = call Laravel. mock = answer from fixtures in src/lib/api/mock (development only; ignored in production).
NEXT_PUBLIC_API_MODE=live

# Server-only: Laravel's session cookie name (backend SESSION_COOKIE; default "<APP_NAME slug>-session").
SESSION_COOKIE_NAME=pawfolio-session
